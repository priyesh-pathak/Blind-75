class Solution {
    private boolean helperFnc(char current, char peak) {
        if (current == ')' && peak == '('
                || current == ']' && peak == '['
                || current == '}' && peak == '{') {
            return true;
        } else {
            return false;
        }
    }

    public boolean isValid(String s) {
        Stack<Character> stack = new Stack<>();
        for (int i = 0; i < s.length(); i++) {
            char current = s.charAt(i);
            if (current == '(' || current == '[' || current == '{') {
                stack.push(current);
            } else {
                if (stack.isEmpty()) {
                    return false;
                }
                if (helperFnc(current, stack.pop()) == false) {
                    return false;
                }
            }
        }
        return stack.isEmpty();
    }
}