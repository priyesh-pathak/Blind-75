    private int helperFnc(int n,int[] dp){
        if(n<0) return 0;
        if(n==0) return 1;
        if(dp[n]!=-1) return dp[n];
        dp[n]= helperFnc(n-1,dp) + helperFnc(n-2,dp);
        return dp[n];
    }
    public int climbStairs(int n) { 
        int[] dp = new int[n+1];
        Arrays.fill(dp,-1);
        return helperFnc(n,dp);    
    }
}